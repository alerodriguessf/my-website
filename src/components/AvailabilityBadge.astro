<div class="availability-badge">
  <span class="availability-light"></span>
  <span class="availability-text-label">Available from</span>
  <span class="availability-text-value">March 2026</span>
</div>

<style>
  .availability-badge {
    position: fixed;
    right: 1.75rem;
    bottom: 1.75rem;
    z-index: 50;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.68rem 1.15rem 0.68rem 0.8rem;
    border-radius: 999px;
    background: rgba(249, 250, 251, 0.96);
    border: 1px solid rgba(209, 213, 219, 0.9);
    box-shadow:
      0 18px 40px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(148, 163, 184, 0.35);
    color: #111827;
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }

  .availability-light {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #4ade80;
    box-shadow: 0 0 0 1px rgba(34, 197, 94, 0.8);
  }

  .availability-light::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: inherit;
    background: radial-gradient(circle, rgba(74, 222, 128, 0.4), transparent 60%);
    opacity: 0;
    animation: availability-pulse 2.6s ease-out infinite;
  }

  @keyframes availability-pulse {
    0% {
      opacity: 0.7;
      transform: scale(0.85);
    }
    40% {
      opacity: 0.0;
      transform: scale(1.35);
    }
    100% {
      opacity: 0;
      transform: scale(1.55);
    }
  }
</style>
