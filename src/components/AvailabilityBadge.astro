<div class="availability-badge">
  <span class="availability-light"></span>
  <span class="availability-text-label">Available from</span>
  <span class="availability-text-value">March 2026</span>
</div>

<style>
  .availability-badge {
    position: fixed;
    right: 1.75rem;
    bottom: 1.75rem;
    z-index: 50;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.68rem 1.15rem 0.68rem 0.8rem;
    border-radius: 999px;
    background: rgba(249, 250, 251, 0.96);
    border: 1px solid rgba(209, 213, 219, 0.9);
    box-shadow:
      0 18px 40px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(148, 163, 184, 0.35);
    color: #111827;
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }

  .availability-light {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #4ade80;
    box-shadow: 0 0 0 1px rgba(34, 197, 94, 0.8);
    flex-shrink: 0;
  }

  /* First ring — faster, closer */
  .availability-light::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: transparent;
    border: 2px solid rgba(74, 222, 128, 0.7);
    animation: ping 2.4s ease-out infinite;
  }

  /* Second ring — slower, delayed, spreads further */
  .availability-light::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: transparent;
    border: 1.5px solid rgba(74, 222, 128, 0.4);
    animation: ping 2.4s ease-out 0.8s infinite;
  }

  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(3.2);
      opacity: 0;
    }
  }
</style>