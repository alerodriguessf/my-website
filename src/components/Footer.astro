---
const email = "alerodriguessf@gmail.com";
---

<style>
  .copy-btn {
    background: rgba(255, 255, 255, 0.105);
    color: rgba(255, 255, 255, 0.86);
    font-size: 1.02rem;
    padding: 0.52rem 1.05rem;
    border-radius: 10px;
    font-weight: 400;
    letter-spacing: 0.04em;
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      0 2px 8px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    cursor: pointer;
    transition: background 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
  }

  .copy-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    color: rgba(255, 255, 255, 0.98);
    border-color: rgba(255, 255, 255, 0.24);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.24),
      0 4px 16px rgba(0, 0, 0, 0.35),
      0 0 0 1px rgba(255, 255, 255, 0.10);
  }
</style>

<section id="contact" style="
  max-width: 880px;
  margin: 4rem auto 2rem auto;
  padding: 0 1rem;
  font-family: Helvetica, sans-serif;
  color: #fff;
">
  <p style="font-size: 2.2rem; color: #aaa; margin-bottom: 0.75rem;">
    get in touch
  </p>

  <h2 style="
    font-size: 2.5rem;
    margin: 0 0 1rem 0;
    font-weight: bold;
    line-height: 1.2;
    word-break: break-word;
  ">
    <a href={`mailto:${email}`} style="color: white; text-decoration: none;">
      {email}
    </a>
  </h2>

  <button
    class="copy-btn"
    onclick={`navigator.clipboard.writeText('${email}'); alert('Email copied to clipboard!');`}
  >
    Copy email address
  </button>
</section>

<footer style="
  max-width: 880px;
  margin: 2rem auto 4rem auto;
  padding: 0 1rem;
  text-align: left;
  color: #a3a0a0;
  font-size: 1.1rem;
  font-family: Helvetica, sans-serif;
  line-height: 1.5;
">
  <p style="margin: 0 0 0.5rem 0;">
    website hand coded with <strong style="color: #a3a0a0; text-decoration: underline;">Astro</strong> (v5.10.1)
  </p>
</footer>