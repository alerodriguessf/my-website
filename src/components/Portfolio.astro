---
const projects = [
       {
    title: "helping 75.000 family farmers prepare for climate change",
    subtitle: "(Powerbi, Statistical Analysis, Data Visualization)",
    image: "/images/andre-magalhaes-paCMZPVhUfc-unsplash.jpg",
    link: "https://github.com/alerodriguessf/sertaovivo_dashboard_climatechange"
  },
       {
    title: "building a elt pipeline using the adventure works dataset",
    subtitle: "(Meltano, Databricks, dbt, Docker)",         
    image: "/images/the-blowup-lqx_D7xIZ2o-unsplash.jpg",
    link: "https://github.com/alerodriguessf/lighthouse_desafio03_alexandrersf-"
  },
     {
    title: "evaluating political forecasting through a gamified prediction platform",
    subtitle: "(Data Analysis, Political Forecasting, Experimental Design)",         
    image: "/images/leon-pascal-jc-2Axv9DC4Twk-unsplash.jpg",
    link: "https://medium.com/@alexandrersf/confidence-chaos-and-the-politics-of-prediction-c281593dc6f3"
  },
   {
    title: "handcoding this website using Astro",
    subtitle: "(Astro, CSS, JavaScript)",
    image: "/images/markus-spiske-PsRUMc7vilg-unsplash.jpg",
    link: "https://github.com/alerodriguessf/my_website"
  }, 
{
    title: "predicting churn in streaming services",
    subtitle: "(Logistic Regression, Python, Sklearn, GridSearchCV)",
    image: "/images/thibault-penin-AWOl7qqsffM-unsplash.jpg",
    link: "https://github.com/alerodriguessf/predicting-churn-in-streaming-service"
  },
  {
    title: "clustering e-commerce clients using kmeans",
    subtitle: "(Python, Sklearn, Pandas, Kmeans)",
    image: "/images/mike-petrucci-c9FQyqIECds-unsplash.jpg",
    link: "https://github.com/alerodriguessf/kmeans-clustering-clients-commerce"
  },
  {
    title: "predicting apple stock prices using sarimax",
    subtitle: "(Python, Sarimax, ARIMA, Sklearn)",
    image: "/images/laurenz-heymann-VkfhJLz5SMQ-unsplash.jpg",
    link: "https://github.com/alerodriguessf/predicting-apple-stock-price"
  }
];
---

<section id="portfolio" style="max-width: 880px; margin: 3rem auto 2rem auto; padding: 0 1rem;">
  <p style="
    font-size: 1.65rem;
    font-weight: regular;
    color: #ffffff;
    margin: 0 0 1rem 0;
    line-height: 1.3;
    max-width: 880px;
  ">
    a selection of projects and exercises:
  </p>


  <div style="
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1rem;
  ">
    {projects.map(project => (
      <a href={project.link} target="_blank" style="text-decoration: none; color: inherit;">
        <div class="project-card" style="
          position: relative;
          height: 160px;
          border-radius: 12px;
          overflow: hidden;
          background: transparent;
          transition: transform 0.3s ease, box-shadow 0.3s ease;
          box-shadow: 
            0 8px 32px rgba(0, 0, 0, 0.4),
            inset 0 1px 0 rgba(255, 255, 255, 0.1);
        ">
          <!-- Imagem de fundo -->
          <img src={project.image} alt={project.title} style="
            position: absolute;
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: grayscale(8%) brightness(92%);
            opacity: 1;
            z-index: 0;
          " />

          <!-- Overlay com gradiente elegante -->
          <div style="
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background:
              linear-gradient(
                to top,
                rgba(229, 231, 235, 0.88) 0%,
                rgba(229, 231, 235, 0.75) 30%,
                rgba(229, 231, 235, 0.52) 60%,
                rgba(229, 231, 235, 0.18) 100%
              );
            backdrop-filter: blur(2px);
            -webkit-backdrop-filter: blur(2px);
            border: 1px solid rgba(203, 213, 225, 0.4);
            z-index: 1;
          "></div>

          <!-- Texto -->
          <div style="
            position: absolute;
            bottom: 0.75rem;
            left: 0.75rem;
            right: 0.75rem;
            color: #111827;
            z-index: 2;
          ">
            <h3 style="
              margin: 0 0 0.25rem 0;
              font-size: 1.05rem;
              font-weight: 600;
              letter-spacing: 0.01em;
              color: #0f172a;
            ">
              {project.title}
            </h3>
            <p style="
              margin: 0;
              font-size: 0.95rem;
              color: #334155;
              font-weight: 400;
            ">
              {project.subtitle}
            </p>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .project-card:hover {
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5) !important;
    transform: translateY(-4px);
  }
</style>
