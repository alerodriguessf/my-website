---
const skills = [
  "SQL",
  "Python",
  "dbt Core",
  "Meltano",
  "Airflow",
  "Docker",
  "Databricks",
  "Azure Data Lake",
  "Power BI",
  "Data Modeling",
  "Git & GitHub"
];
---

<style>
.skill-tag {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.105);
    color: rgba(255, 255, 255, 0.86);
    font-size: 1.02rem;
    padding: 0.52rem 1.05rem;
    border-radius: 10px;
    font-weight: 400;
    letter-spacing: 0.04em;
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      0 2px 8px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition: background 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
    cursor: default;
  }

  .skill-tag:hover {
    background: rgba(255, 255, 255, 0.16);
    color: rgba(255, 255, 255, 0.98);
    border-color: rgba(255, 255, 255, 0.24);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.24),
      0 4px 16px rgba(0, 0, 0, 0.35),
      0 0 0 1px rgba(255, 255, 255, 0.10);
  }
</style>

<section style="
  max-width: 880px;
  margin: 3.5rem auto;
  padding: 0 2rem;
  text-align: left;
">
  <p style="
    font-size: 2.2rem;
    color: #aaa;
    margin: 0 0 0.5rem 0;
    letter-spacing: 0.08rem;
  ">
    what i am good at
  </p>

  <h2 style="
    font-size: 2.5rem;
    font-weight: bold;
    margin: 0 0 1.5rem 0;
    line-height: 1.3;
    color: #fff;
  ">
    business intelligence<br>
    for small companies and startups  </h2>  </h2>

  <p style="
    font-size: 1.2rem;
    color: #aaa;
    line-height: 1.6;
    margin-bottom: 2rem;
  ">
    from orchestrating ELT pipelines to crafting decision-ready dashboards,
    i work across the modern data stack to design BI dashboards and structured analyses that drive real decisions
  </p>

  <div style="
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  ">
    {skills.map(skill => (
      <span class="skill-tag">{skill}</span>
    ))}
  </div>
</section>